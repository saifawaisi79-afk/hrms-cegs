# CEGS OS — environment template (no real secrets)
# Copy to .env.local and fill in values. Rotate any secret that was ever committed.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/cegs_hrms?retryWrites=true&w=majority
# Vercel: paste ONLY the URI above as the Value (no quotes, no "MONGODB_URI=" prefix)
PORT=5001
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
# Seed/demo in-memory login is disabled — use Mongo users from `npm run seed` or HR Onboarding
ALLOW_SEED_AUTH=false
# ALLOWED_IP_RANGES=10.30.0.0/20,192.168.32.0/22,127.0.0.1,::1
TRUST_PROXY=false

# WFO office geofence (Novel Office Koramangala defaults)
OFFICE_LAT=12.951361
OFFICE_LNG=77.608194
OFFICE_RADIUS_M=100
OFFICE_NAME=Novel Office Koramangala

# Rotation checklist (ops):
# 1. Generate a new JWT_SECRET and restart the app (invalidates existing sessions).
# 2. Rotate the MongoDB Atlas database user password; update MONGODB_URI.
# 3. Run `npm run seed` after wiping users to mint fresh bootstrap credentials (printed once).
# 4. Never commit .env or .env.local — only this example file.
