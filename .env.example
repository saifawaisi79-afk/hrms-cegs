# CEGS OS — environment template (no real secrets)
# Copy to .env.local and fill in values. Rotate any secret that was ever committed.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/cegs_hrms?retryWrites=true&w=majority
PORT=5001
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
# Local/demo seed login (signs JWT with JWT_SECRET above — never hardcode the secret)
ALLOW_SEED_AUTH=true
# ALLOWED_IP_RANGES=10.30.0.0/20,192.168.32.0/22,127.0.0.1,::1
TRUST_PROXY=false

# Rotation checklist (ops):
# 1. Generate a new JWT_SECRET and restart the app (invalidates existing sessions).
# 2. Rotate the MongoDB Atlas database user password; update MONGODB_URI.
# 3. Never commit .env or .env.local — only this example file.
